<% content_for :title, "Nieuw fonds" %>
<%= render layout: 'shared/public_layout' do %>
  <div class="w-full max-w-lg">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-full mb-4">
        <%= icon :users, class: "w-8 h-8 text-blue-600" %>
      </div>
      <h1 class="text-3xl font-bold text-white mb-2">Nieuw fonds</h1>
      <p class="text-blue-200">Een gezamenlijke pot voor je groep, waar niemand in zijn eentje bij kan.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-2xl p-6 sm:p-8 space-y-6">
      <%= render 'accounts/wizard_steps', current: 1 %>

      <%= form_with model: @account, local: true, class: "space-y-6" do |f| %>
        <%= render 'shared/error_messages', object: f.object %>

        <div>
          <label for="account_name" class="block text-sm font-medium text-gray-700 mb-2">Naam van het fonds</label>
          <%= f.text_field :name, required: true, autofocus: true, placeholder: "bijv. Huisgenoten Amsterdam",
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
        </div>

        <div>
          <label for="account_description" class="block text-sm font-medium text-gray-700 mb-2">Waar is het voor?</label>
          <%= f.text_area :description, rows: 3, placeholder: "bijv. Vaste lasten en de vakantie in augustus",
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition resize-none" %>
          <p class="text-xs text-gray-500 mt-1">Dit zien alleen de leden. Het komt niet op de blockchain.</p>
        </div>

        <details class="p-4 bg-blue-50 rounded-lg text-sm text-blue-800">
          <summary class="font-medium text-blue-900 cursor-pointer flex items-center justify-between gap-2">
            <span>Wat is een fonds, en wie heeft de macht?</span>
            <%= icon :chevron_down, class: "w-4 h-4 details-chevron flex-shrink-0" %>
          </summary>
          <div class="mt-2 space-y-2">
            <p>Het geld staat in een kluis op de blockchain, een <strong>Safe</strong>. FundTogether kan daar niet bij.</p>
            <p>De macht ligt bij de <strong>ondertekenaars</strong>: de mensen die jullie aanwijzen. Een uitgave gaat pas door na genoeg <strong>goedkeuringen</strong>, bijvoorbeeld 2 van de 3.</p>
            <p>Admin zijn in deze app geeft geen macht over het geld.</p>
          </div>
        </details>

        <button type="submit" class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-blue-700 transition-colors focus:ring-4 focus:ring-blue-300 flex items-center justify-center space-x-2">
          <span>Volgende: leden uitnodigen</span>
          <%= icon :arrow_right, class: "w-5 h-5" %>
        </button>
      <% end %>

      <div class="text-center">
        <%= link_to "Terug naar overzicht", dashboard_path, class: "text-gray-600 hover:text-gray-800 text-sm" %>
      </div>
    </div>

    <p class="mt-6 text-center text-blue-100 text-sm">Dit kost nog niets. Er gebeurt pas iets op de blockchain als je de Safe aanmaakt.</p>
  </div>
<% end %>
