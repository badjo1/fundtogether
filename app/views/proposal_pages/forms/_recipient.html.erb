<% members = @member_wallets.select { |row| row[:wallet] } %>
<% link = @recipient_link %>
<div data-controller="recipient" class="space-y-3">
  <% if link %>
    <%= render layout: 'shared/info_panel', locals: { tone: link[:own] ? "info" : "warning", title: "Ontvanger ingevuld vanuit een link" } do %>
      <p class="font-mono text-xs break-hash" data-recipient-link="<%= link[:own] ? "own" : "other" %>"><%= checksum_address(link[:address]) %></p>
      <% if link[:own] %>
        <p>Dit is een van jouw eigen gekoppelde wallets. Controleer het adres voordat je het voorstel maakt.</p>
      <% else %>
        <p>Dit is niet een van jouw eigen wallets. Iedereen kan zo'n link maken, dus controleer wie dit adres is voordat je het voorstel maakt.</p>
      <% end %>
    <% end %>
  <% elsif @recipient_link_invalid %>
    <%= render layout: 'shared/info_panel', locals: { tone: "warning" } do %>
      <p data-recipient-link="invalid">De link bevat geen geldig adres. Kies zelf de ontvanger.</p>
    <% end %>
  <% end %>
  <div>
    <label for="recipient_choice" class="block text-sm font-medium text-gray-700 mb-2">Aan wie?</label>
    <%= select_tag :recipient_choice, options_for_select(members.map { |row| [ "#{row[:user].display_name} (#{checksum_address(row[:wallet].address)})", row[:wallet].address ] } + [ [ "Een ander adres", "other" ] ], params[:recipient_choice] || link&.dig(:choice)), data: { recipient_target: "choice", action: "recipient#update" }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div data-recipient-target="other" hidden>
    <label for="recipient" class="block text-sm font-medium text-gray-700 mb-2">Adres van de ontvanger</label>
    <%= text_field_tag :recipient, (request.post? ? params[:recipient] : link&.dig(:address)), placeholder: "0x…", autocomplete: "off", spellcheck: false, class: "w-full px-4 py-3 border border-gray-300 rounded-lg font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    <p class="text-xs text-gray-500 mt-1">Controleer dit adres goed. Een overboeking op de blockchain kan niemand terugdraaien.</p>
  </div>
</div>
