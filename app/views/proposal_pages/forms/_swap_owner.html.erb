<%= render layout: 'shared/info_panel', locals: {} do %>
  <p>Als dit wordt uitgevoerd, verliest de oude wallet haar macht en krijgt de nieuwe die. Dit is de manier om een kwijtgeraakte of gehackte wallet te vervangen. Tot dan telt de oude nog mee.</p>
  <p>Controleer via een ander kanaal, bijvoorbeeld per telefoon, dat het nieuwe adres echt van deze persoon is.</p>
  <% if @account.duplicate_member_names.any? %><p class="text-red-700" data-testid="duplicate-name">Let op: meerdere leden hebben dezelfde naam. Kies op adres.</p><% end %>
<% end %>
<div>
  <label for="old_owner" class="block text-sm font-medium text-gray-700 mb-2">Welke ondertekenaar vervang je?</label>
  <%= select_tag :old_owner, options_for_select(@owners.map { |owner| [ "#{owner[:name] || 'Onbekend'} (#{checksum_address(owner[:address])})", owner[:address] ] }, params[:old_owner]), class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
</div>
<% if @new_owner_options.empty? %>
  <%= render layout: 'shared/info_panel', locals: { tone: "warning", title: "Geen nieuwe wallet beschikbaar" } do %>
    <p>De nieuwe wallet moet aan een lid gekoppeld zijn en nog geen ondertekenaar zijn. Koppel die eerst bij <%= link_to "Mijn wallets", wallet_page_path, class: "underline font-medium" %>.</p>
  <% end %>
<% else %>
  <div>
    <label for="new_owner" class="block text-sm font-medium text-gray-700 mb-2">Door wie of welke wallet?</label>
    <%= select_tag :new_owner, options_for_select(@new_owner_options.map { |row| [ "#{row[:user].display_name} (#{checksum_address(row[:wallet].address)})", row[:wallet].address ] }, params[:new_owner]), class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
<% end %>
