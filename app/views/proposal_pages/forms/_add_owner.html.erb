<% count = @owners.length + 1 %>
<div class="space-y-5">
  <%= render layout: 'shared/info_panel', locals: {} do %>
    <p>Als dit wordt uitgevoerd, kan deze persoon meebeslissen over al het geld in het fonds. Alleen leden met een bevestigd e-mailadres en een gekoppelde wallet kunnen ondertekenaar worden.</p>
    <p>Controleer via een ander kanaal, bijvoorbeeld per telefoon, dat dit adres echt van deze persoon is. Een naam hier zegt daar niets over.</p>
    <% if @account.duplicate_member_names.any? %><p class="text-red-700" data-testid="duplicate-name">Let op: meerdere leden hebben dezelfde naam. Kies op adres.</p><% end %>
  <% end %>
  <% if @new_owner_options.empty? %>
    <%= render layout: 'shared/info_panel', locals: { tone: "warning", title: "Niemand beschikbaar" } do %>
      <p>Er is geen lid met een gekoppelde wallet dat nog geen ondertekenaar is. <%= @without_wallet.map { |row| row[:user].display_name }.to_sentence(two_words_connector: " en ", last_word_connector: " en ") %> <%= @without_wallet.any? ? "moet eerst een wallet koppelen." : "" %></p>
    <% end %>
  <% else %>
    <div>
      <label for="owner" class="block text-sm font-medium text-gray-700 mb-2">Wie?</label>
      <%= select_tag :owner, options_for_select(@new_owner_options.map { |row| [ "#{row[:user].display_name} (#{checksum_address(row[:wallet].address)})", row[:wallet].address ] }, params[:owner]), class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    <%= render 'proposal_pages/forms/threshold_field', count: count, selected: params[:threshold] || @snapshot.threshold %>
  <% end %>
</div>
