<%= render layout: 'shared/info_panel', locals: {} do %>
  <p>Dit stuurt <%= @chain.native_symbol %>, de munt voor netwerkkosten, uit de Safe. Bedoeld voor wat er per ongeluk terecht is gekomen. Dat is definitief.</p>
<% end %>
<%= render 'proposal_pages/forms/recipient' %>
<div data-controller="amount-echo" data-amount-echo-decimals-value="<%= 18 %>" data-amount-echo-symbol-value="<%= @chain.native_symbol %>">
  <label for="amount" class="block text-sm font-medium text-gray-700 mb-2">Bedrag</label>
  <div class="relative">
    <%= text_field_tag :amount, params[:amount], required: true, data: { amount_echo_target: "input", action: "input->amount-echo#update" }, inputmode: "decimal", autocomplete: "off", placeholder: "0,00", class: "w-full pl-4 pr-20 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 tabular-nums text-lg" %>
    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium"><%= @chain.native_symbol %></span>
  </div>
  <p class="text-sm font-medium text-gray-900 mt-1" data-amount-echo-target="output" aria-live="polite"></p>
</div>
