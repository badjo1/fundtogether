<% content_for :title, "E-mailadres bevestigen" %>
<%= render layout: 'shared/public_layout' do %>
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8 space-y-4">
    <%= render 'shared/flash_messages' %>
    <h1 class="text-2xl font-bold text-gray-900">Bevestig je e-mailadres</h1>
    <p class="text-gray-700">We hebben een mail gestuurd naar <strong class="break-all"><%= current_user.email_address %></strong>. Open de link uit die mail. De link is 24 uur geldig.</p>
    <p class="text-sm text-gray-600">Tot je hebt bevestigd kun je inloggen en rondkijken, maar geen wallet koppelen, niet meedoen via een uitnodiging op dit adres en geen ondertekenaar worden. Zo weet de groep dat dit adres echt van jou is.</p>
    <%= button_to "Mail opnieuw sturen", resend_email_confirmation_path, class: "w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium" %>
    <p class="text-sm text-gray-500 text-center"><%= link_to "Verder naar FundTogether", dashboard_path, class: "text-blue-600 hover:text-blue-700 font-medium" %></p>
  </div>
<% end %>
