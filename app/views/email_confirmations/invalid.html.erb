<% content_for :title, "Link verlopen" %>
<%= render layout: 'shared/public_layout' do %>
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8 space-y-4">
    <h1 class="text-2xl font-bold text-gray-900">Deze link werkt niet meer</h1>
    <p class="text-gray-700">De link is verlopen of al gebruikt. Log in om je e-mailadres te bevestigen of een nieuwe mail te laten sturen.</p>
    <p><%= link_to "Inloggen", new_session_path, class: "text-blue-600 hover:text-blue-700 font-medium" %></p>
  </div>
<% end %>
