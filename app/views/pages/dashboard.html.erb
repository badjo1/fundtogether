<% content_for :title, "Overzicht: #{@account.name}" %>
<%= render layout: 'shared/app_layout' do %>
  <div class="space-y-6 max-w-5xl mx-auto">
    <div class="flex items-start justify-between flex-wrap gap-4">
      <div class="min-w-0">
        <h2 class="text-2xl font-bold text-gray-900">Dashboard</h2>
        <p class="text-sm text-gray-500 mt-1 break-words"><%= @account.name %><% if @account.description.present? %>: <%= @account.description %><% end %></p>
      </div>
      <% if @account.safe_active? && @chain && !current_membership.viewer? %>
        <div class="flex gap-2 flex-wrap">
          <%= link_to account_contribute_path(@account), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center space-x-2 font-medium" do %>
            <%= icon :arrow_down, class: "w-4 h-4" %><span>Inleggen</span>
          <% end %>
          <%= link_to new_account_proposal_page_path(@account), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 flex items-center space-x-2 font-medium" do %>
            <%= icon :plus, class: "w-4 h-4" %><span>Nieuw voorstel</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @account.chain_id && @chain.nil? %>
      <%= render layout: 'shared/info_panel', locals: { tone: "warning", title: "Netwerk niet beschikbaar" } do %>
        <p>Het netwerk van dit fonds staat in FundTogether uit. Je geld staat er nog: open je Safe rechtstreeks in Safe{Wallet}.</p>
      <% end %>
    <% elsif @account.safe_active? %>
      <%= render 'pages/dashboard/active' %>
    <% elsif @account.safe_deploying? %>
      <%= render 'pages/dashboard/deploying' %>
    <% else %>
      <%= render 'pages/dashboard/draft' %>
    <% end %>

    <section aria-labelledby="fondsen-titel">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h3 id="fondsen-titel" class="text-lg font-bold text-gray-900">Mijn fondsen</h3>
        <%= link_to new_account_path, class: "text-sm text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1" do %>
          <%= icon :plus, class: "w-4 h-4" %><span>Nieuw fonds</span>
        <% end %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @funds.each do |fund| %>
          <%= render 'pages/dashboard/fund_tile', fund: fund %>
        <% end %>
      </div>
    </section>
  </div>
<% end %>
