<% content_for :title, "Leden uitnodigen" %>
<%= render layout: 'shared/app_layout' do %>
  <div class="max-w-2xl mx-auto space-y-6">
    <%= render 'accounts/wizard_steps', current: 2 %>
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Haal de groep erbij</h2>
      <p class="text-sm text-gray-500 mt-1">Leden kunnen het fonds zien en ondertekenaar worden. Lid zijn alleen geeft nog geen macht over het geld.</p>
    </div>

    <section class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Iemand uitnodigen</h3>
      <%= form_with url: invitations_path, scope: :invitation, method: :post, class: "space-y-4" do |f| %>
        <%= hidden_field_tag :account_id, @account.id %>
        <div>
          <label for="invitation_email" class="block text-sm font-medium text-gray-700 mb-2">E-mailadres <span class="text-gray-500 font-normal text-xs">(optioneel)</span></label>
          <%= f.email_field :email, placeholder: "naam@voorbeeld.nl", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          <p class="text-xs text-gray-500 mt-1">Laat leeg om een link te delen via WhatsApp of QR-code. Een uitnodiging is 24 uur geldig.</p>
        </div>
        <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors">Uitnodiging maken</button>
      <% end %>
    </section>

    <section class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Wie er al zijn</h3>
      <ul class="space-y-2">
        <% @members.each do |user| %>
          <li class="flex items-center justify-between gap-3 p-3 bg-gray-50 rounded-lg">
            <span class="font-medium text-gray-900 text-sm truncate"><%= user.display_name %></span>
            <% if user.wallets.active.exists? %>
              <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800 font-medium flex-shrink-0">Wallet gekoppeld</span>
            <% else %>
              <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800 font-medium flex-shrink-0">Nog geen wallet</span>
            <% end %>
          </li>
        <% end %>
        <% @pending.each do |invitation| %>
          <li class="flex items-center justify-between gap-3 p-3 bg-gray-50 rounded-lg">
            <span class="text-gray-600 text-sm truncate"><%= invitation.email.presence || "Uitnodiging via link" %></span>
            <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800 font-medium flex-shrink-0">Uitgenodigd</span>
          </li>
        <% end %>
      </ul>
    </section>

    <div class="flex flex-col-reverse sm:flex-row gap-3 sm:justify-end">
      <%= link_to "Later doen", dashboard_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium text-center" %>
      <%= link_to "Volgende: fonds instellen", account_safe_setup_path(@account), class: "px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium text-center" %>
    </div>
  </div>
<% end %>
