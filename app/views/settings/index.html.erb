<% content_for :title, "Instellingen" %>
<%= render layout: 'shared/app_layout' do %>
  <div class="space-y-6" data-controller="confirm-modal">
    <h2 class="text-2xl font-bold text-gray-900">Instellingen</h2>

    <!-- Group Settings -->
    <% if current_membership.admin? %>
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-6">Fondsinstellingen</h3>

      <%= form_with model: @account, url: settings_path, method: :patch, local: true do |f| %>
        <%= hidden_field_tag :account_id, @account.id %>
        <% if @account.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <div class="flex items-start gap-3">
              <%= icon :x_circle, class: "w-5 h-5 text-red-600 mt-0.5" %>
              <div class="flex-1">
                <h4 class="font-medium text-red-900">
                  <%= pluralize(@account.errors.count, "fout") %> gevonden:
                </h4>
                <ul class="mt-2 text-sm text-red-700 list-disc list-inside space-y-1">
                  <% @account.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <div>
            <label for="account_name" class="block text-sm font-medium text-gray-700 mb-2">Naam van het fonds</label>
            <%= f.text_field :name,
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              required: true
            %>
            <p class="text-xs text-gray-500 mt-1">De naam zoals andere leden die zien</p>
          </div>

          <div>
            <label for="account_description" class="block text-sm font-medium text-gray-700 mb-2">Waar is het voor?</label>
            <%= f.text_area :description,
              rows: 3,
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            %>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <%= f.submit 'Wijzigingen Opslaan',
              class: "flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 font-medium transition-colors"
            %>
            <%= link_to 'Annuleren', settings_path,
              class: "text-center px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium transition-colors"
            %>
          </div>
        </div>
      <% end %>
    </div>
    <% else %>
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-6">Fondsinstellingen</h3>
      <p class="font-medium text-gray-900"><%= @account.name %></p>
      <% if @account.description.present? %>
        <p class="text-sm text-gray-500 mt-1"><%= @account.description %></p>
      <% end %>
      <p class="text-xs text-gray-500 mt-4">Alleen admins kunnen deze instellingen wijzigen.</p>
    </div>
    <% end %>

    <!-- De Safe van dit fonds -->
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Safe</h3>
      <% if @account.safe_active? %>
        <p class="text-sm text-gray-600">Dit fonds is een Safe op de blockchain. Het netwerk, de munt en het adres liggen vast. Ondertekenaars en goedkeuringen wijzig je met een voorstel.</p>
        <%= link_to "Bekijk de Safe en wie er mag ondertekenen", account_transparency_path(@account), class: "inline-block mt-3 text-sm text-blue-600 hover:text-blue-700 font-medium" %>
      <% elsif @account.safe_deploying? %>
        <p class="text-sm text-gray-600">De Safe wordt aangemaakt.</p>
        <%= link_to "Bekijk de voortgang", account_safe_setup_path(@account), class: "inline-block mt-3 text-sm text-blue-600 hover:text-blue-700 font-medium" %>
      <% else %>
        <p class="text-sm text-gray-600">Dit fonds heeft nog geen Safe. Er kan dus nog geen geld in.</p>
        <% if current_membership.admin? %>
          <%= link_to "Fonds instellen", account_safe_setup_path(@account), class: "inline-block mt-3 text-sm text-blue-600 hover:text-blue-700 font-medium" %>
        <% end %>
      <% end %>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-xl p-6 shadow-sm border border-red-200">
      <h3 class="text-lg font-bold text-red-900 mb-6">Gevarenzone</h3>

      <div class="space-y-4">
        <!-- Fonds Verlaten -->
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border border-red-200 rounded-lg">
          <div class="min-w-0">
            <p class="font-medium text-gray-900">Fonds verlaten</p>
            <p class="text-sm text-gray-500">Je verliest toegang tot dit fonds in FundTogether</p>
          </div>
          <button
            type="button"
            data-action="click->confirm-modal#openLeave"
            class="px-4 py-2 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 text-sm font-medium"
          >
            Fonds Verlaten
          </button>
        </div>

        <% if current_membership.admin? %>
        <!-- Fonds Verwijderen -->
        <div class="flex items-center justify-between flex-wrap gap-3 p-4 border border-red-200 rounded-lg">
          <div class="min-w-0">
            <p class="font-medium text-gray-900">Fonds verwijderen</p>
            <p class="text-sm text-gray-500">Kan alleen zolang er geen Safe op de blockchain is</p>
          </div>
          <button
            type="button"
            data-action="click->confirm-modal#openDelete"
            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium"
          >
            Fonds Verwijderen
          </button>
        </div>
        <% end %>
      </div>
    </div>

    <!-- Leave Account Modal -->
    <div
      data-confirm-modal-target="leaveModal"
      class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="p-3 bg-yellow-100 rounded-full">
            <%= icon :warning, class: "w-6 h-6 text-yellow-600" %>
          </div>
          <h3 class="text-lg font-bold text-gray-900">Fonds Verlaten</h3>
        </div>

        <p class="text-gray-600 mb-4">
          Weet je zeker dat je dit fonds wilt verlaten?
        </p>

        <ul class="text-sm text-gray-600 mb-6 space-y-2">
          <li class="flex items-center gap-2">
            <%= icon :warning, class: "w-4 h-4 text-yellow-500" %>
            <span>Je verliest toegang tot de gegevens in FundTogether. Ben je ondertekenaar, dan blijf je dat op de blockchain tot de groep dat wijzigt.</span>
          </li>
        </ul>

        <p class="text-sm text-gray-500 mb-6">
          Het fonds blijft bestaan voor de andere leden.
        </p>

        <div class="flex gap-3">
          <button
            type="button"
            data-action="click->confirm-modal#closeLeave"
            class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium"
          >
            Annuleren
          </button>
          <%= button_to leave_account_path(@account),
              method: :delete,
              class: "flex-1 px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 font-medium" do %>
            Ja, verlaat fonds
          <% end %>
        </div>
      </div>
    </div>

    <% if current_membership.admin? %>
    <!-- Delete Account Modal -->
    <div
      data-confirm-modal-target="deleteModal"
      class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="p-3 bg-red-100 rounded-full">
            <%= icon :trash, class: "w-6 h-6 text-red-600" %>
          </div>
          <h3 class="text-lg font-bold text-gray-900">Fonds Permanent Verwijderen</h3>
        </div>

        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
          <p class="text-red-800 text-sm font-medium">
            Let op: Deze actie kan niet ongedaan worden gemaakt!
          </p>
        </div>

        <p class="text-gray-600 mb-4">
          Het volgende wordt permanent verwijderd:
        </p>

        <ul class="text-sm text-gray-600 mb-6 space-y-2">
          <li class="flex items-center gap-2">
            <%= icon :x_circle, class: "w-4 h-4 text-red-500" %>
            <span>Alle ledengegevens en uitnodigingen</span>
          </li>
          <li class="flex items-center gap-2">
            <%= icon :x_circle, class: "w-4 h-4 text-red-500" %>
            <span>Alle instellingen van dit fonds</span>
          </li>
        </ul>

        <p class="text-sm text-red-600 font-medium mb-6">
          Alle leden verliezen toegang tot dit fonds.
        </p>

        <div class="flex gap-3">
          <button
            type="button"
            data-action="click->confirm-modal#closeDelete"
            class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium"
          >
            Annuleren
          </button>
          <%= button_to account_path(@account),
              method: :delete,
              class: "flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium" do %>
            Permanent Verwijderen
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
<% end %>
