<%# Locals: title (optional), tone: info|warning|danger. Het blok is de tekst. %>
<% tone = local_assigns[:tone] || "info" %>
<% classes = { "info" => "bg-blue-50 border-blue-200", "warning" => "bg-yellow-50 border-yellow-200", "danger" => "bg-red-50 border-red-200" }[tone] %>
<% title_class = { "info" => "text-blue-900", "warning" => "text-yellow-900", "danger" => "text-red-900" }[tone] %>
<% body_class = { "info" => "text-blue-700", "warning" => "text-yellow-800", "danger" => "text-red-800" }[tone] %>
<% icon_class = { "info" => "w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0", "warning" => "w-5 h-5 text-yellow-600 mt-0.5 flex-shrink-0", "danger" => "w-5 h-5 text-red-600 mt-0.5 flex-shrink-0" }[tone] %>
<div class="p-4 rounded-lg border <%= classes %>">
  <div class="flex items-start gap-3">
    <%= icon(tone == "info" ? :info : :warning, class: icon_class) %>
    <div class="flex-1 min-w-0">
      <% if local_assigns[:title] %><p class="font-medium <%= title_class %>"><%= title %></p><% end %>
      <div class="text-sm <%= body_class %> <%= 'mt-1' if local_assigns[:title] %> space-y-2"><%= yield %></div>
    </div>
  </div>
</div>
