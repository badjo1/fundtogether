<aside class="fixed inset-y-0 left-0 z-50 w-64 bg-gray-900 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col" data-dapp-target="sidebar" aria-label="Hoofdmenu">
  <div class="flex items-center justify-between h-16 px-4 bg-gray-800 flex-shrink-0">
    <%= link_to dashboard_path, class: "flex items-center space-x-2" do %>
      <%= icon :users, class: "w-8 h-8 text-blue-400" %>
      <span class="text-lg font-bold text-white">FundTogether</span>
    <% end %>
    <button type="button" data-action="click->dapp#toggleSidebar" aria-label="Menu sluiten" class="lg:hidden text-gray-400 hover:text-white">
      <%= icon :x, class: "w-5 h-5" %>
    </button>
  </div>

  <div class="flex-1 min-h-0 overflow-y-auto pb-4">
    <%= render 'shared/account_switcher' %>

    <nav class="mt-4 px-4 space-y-1" aria-label="Fonds">
      <%= nav_item "Overzicht", dashboard_path, :chart %>
      <% if current_account %>
        <% fund = current_account %>
        <%= nav_item "Inleggen", account_contribute_path(fund), :arrow_down %>
        <%= nav_item "Voorstellen", account_proposal_pages_path(fund), :check_circle, active: request.path.start_with?(account_proposal_pages_path(fund)) %>
        <%= nav_item "Activiteit", account_activity_path(fund), :clock %>
        <%= nav_item "Geld storten/opnemen", account_ramp_path(fund), :dollar %>
        <%= nav_item "Groepsleden", users_path, :users %>
        <%= nav_item "Transparantie", account_transparency_path(fund), :shield %>
      <% end %>
    </nav>

    <nav class="mt-4 pt-4 mx-4 border-t border-gray-800 space-y-1" aria-label="Persoonlijk">
      <%= nav_item "Mijn wallets", wallet_page_path, :wallet %>
      <%= nav_item "Instellingen", settings_path, :settings %>
    </nav>
  </div>

  <p class="flex-shrink-0 px-4 py-3 text-center text-gray-500 text-xs">FundTogether bewaart geen geld en geen sleutels.</p>
</aside>
